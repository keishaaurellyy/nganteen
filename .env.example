# PostgreSQL connection string (e.g. from Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Random string that signs sessions: openssl rand -base64 32
NEXTAUTH_SECRET=
# App URL (Vercel sets this automatically)
NEXTAUTH_URL=http://localhost:3000
# bcrypt hash of the admin password, see README
ADMIN_PASSWORD_HASH=
